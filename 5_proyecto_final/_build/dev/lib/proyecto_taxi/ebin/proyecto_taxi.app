{application,proyecto_taxi,
             [{modules,['Elixir.Taxi.Application','Elixir.Taxi.Location',
                        'Elixir.Taxi.Server','Elixir.Taxi.Trip',
                        'Elixir.Taxi.TripSupervisor',
                        'Elixir.Taxi.UserManager']},
              {compile_env,[{proyecto_taxi,[data_dir],{ok,<<"data">>}},
                            {proyecto_taxi,[score_rewards],error},
                            {proyecto_taxi,[tcp_port],{ok,4040}},
                            {proyecto_taxi,[trip_timeout],{ok,20000}}]},
              {optional_applications,[]},
              {applications,[kernel,stdlib,elixir,logger]},
              {description,"proyecto_taxi"},
              {registered,[]},
              {vsn,"0.1.0"},
              {mod,{'Elixir.Taxi.Application',[]}}]}.
